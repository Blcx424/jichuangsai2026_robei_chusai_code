<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="  // 方向宏定义，方便阅读&#xa;  localparam [1:0]&#xa;          DIR_STOP  = 2'b00,&#xa;          DIR_FWD   = 2'b01,&#xa;          DIR_BACK  = 2'b10;&#xa;  &#xa;      // 接收缓存：7字节一帧，格式：0xAA + cmd + L_speed + R_speed + L_dir + R_dir + 0x55&#xa;      reg [7:0] rx_buffer [0:6];&#xa;      reg [2:0] byte_cnt;          // 当前接收字节计数，0~6&#xa;      reg [1:0] rx_state;&#xa;      localparam [1:0]&#xa;          RX_IDLE      = 2'b00,    // 等待帧头 0xAA&#xa;          RX_RECEIVE   = 2'b01,    // 接收剩余6个字节&#xa;          RX_PARSE     = 2'b10;    // 解析并输出结果，持续一个周期&#xa;&#xa;      integer i;  // 循环初始化&#xa;&#xa;      // 测试信号&#xa;      reg led_test_any;&#xa;      reg led_test_aa;&#xa;      &#xa;      reg connected;    // 蓝牙是否已收到过有效帧&#xa;&#xa;      // ========== 蓝牙连接状态管理 ==========&#xa;      // 一旦成功解析一帧，就认为连接建立，之后一直保持&#xa;      always @(posedge clk or negedge rst_n) begin&#xa;          if (!rst_n) begin&#xa;              connected &lt;= 1'b0;&#xa;          end&#xa;          else begin&#xa;              if (frame_ready) begin&#xa;                  connected &lt;= 1'b1;&#xa;              end&#xa;          end&#xa;      end&#xa;&#xa;      // ========== 蓝牙帧解析状态机 ==========&#xa;      always @(posedge clk or negedge rst_n) begin&#xa;          if (!rst_n) begin&#xa;              rx_state &lt;= RX_IDLE;&#xa;              byte_cnt &lt;= 3'd0;&#xa;              frame_ready &lt;= 1'b0;&#xa;              // 清空缓存及输出寄存器&#xa;              for (i = 0; i &lt; 7; i = i + 1) begin&#xa;                  rx_buffer[i] &lt;= 8'h0;&#xa;              end&#xa;              left_speed_reg  &lt;= 8'd0;&#xa;              right_speed_reg &lt;= 8'd0;&#xa;              left_dir_reg    &lt;= DIR_STOP;&#xa;              right_dir_reg   &lt;= DIR_STOP;&#xa;              cmd &lt;= 8'd0;&#xa;          end&#xa;          else begin&#xa;              case (rx_state)&#xa;                  RX_IDLE: begin&#xa;                      frame_ready &lt;= 1'b0;          // 保持低&#xa;                      // 检测帧头 0xAA&#xa;                      if (rx_done &amp;&amp; rx_data == 8'hAA) begin&#xa;                          rx_buffer[0] &lt;= rx_data;&#xa;                          byte_cnt &lt;= 3'd1;&#xa;                          rx_state &lt;= RX_RECEIVE;&#xa;                          led_test_aa &lt;= 1'b1;      // 帧头指示灯&#xa;                      end&#xa;                  end&#xa;&#xa;                  RX_RECEIVE: begin&#xa;                      if (rx_done) begin&#xa;                          // 将当前字节存入对应位置&#xa;                          case (byte_cnt)&#xa;                              3'd1: rx_buffer[1] &lt;= rx_data;&#xa;                              3'd2: rx_buffer[2] &lt;= rx_data;&#xa;                              3'd3: rx_buffer[3] &lt;= rx_data;&#xa;                              3'd4: rx_buffer[4] &lt;= rx_data;&#xa;                              3'd5: rx_buffer[5] &lt;= rx_data;&#xa;                              3'd6: rx_buffer[6] &lt;= rx_data;&#xa;                          endcase&#xa;&#xa;                          // 收到最后一个字节时检查帧尾 0x55&#xa;                          if (byte_cnt == 3'd6) begin&#xa;                              if (rx_data == 8'h55) begin&#xa;                                  // 立即输出命令字节，同时拉高frame_ready&#xa;                                  cmd &lt;= rx_buffer[1];&#xa;                                  frame_ready &lt;= 1'b1;&#xa;                                  rx_state &lt;= RX_PARSE;&#xa;                                  led_test_any &lt;= 1'b1; // 有效帧指示灯&#xa;                              end&#xa;                              // 帧尾错误则丢弃，不跳转&#xa;                              else begin&#xa;                                  rx_state &lt;= RX_IDLE;  &#xa;                              end&#xa;                          end&#xa;                          else begin&#xa;                              byte_cnt &lt;= byte_cnt + 3'd1;&#xa;                          end&#xa;                      end&#xa;                  end&#xa;&#xa;                  RX_PARSE: begin&#xa;                      // 更新速度和方向，供外部模块直接使用&#xa;                      left_speed_reg &lt;= rx_buffer[2];&#xa;                      right_speed_reg &lt;= rx_buffer[3];&#xa;&#xa;                      case (rx_buffer[4])&#xa;                          8'h01: left_dir_reg &lt;= DIR_FWD;&#xa;                          8'h02: left_dir_reg &lt;= DIR_BACK;&#xa;                          default: left_dir_reg &lt;= DIR_STOP;&#xa;                      endcase&#xa;&#xa;                      case (rx_buffer[5])&#xa;                          8'h01: right_dir_reg &lt;= DIR_FWD;&#xa;                          8'h02: right_dir_reg &lt;= DIR_BACK;&#xa;                          default: right_dir_reg &lt;= DIR_STOP;&#xa;                      endcase&#xa;&#xa;                      // frame_ready 只保持一个周期，供外部捕获 cmd&#xa;                      frame_ready &lt;= 1'b0;&#xa;                      rx_state &lt;= RX_IDLE;           // 准备接收下一帧&#xa;                  end&#xa;&#xa;                  default: rx_state &lt;= RX_IDLE;&#xa;              endcase&#xa;          end&#xa;      end&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="packet_parser" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="packet_parser" Side="left" Width="30" X="-0.01875" Y="0.186111"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="packet_parser" Side="left" Width="30" X="-0.01875" Y="0.386111"/>
 <Port Color="#ff1493" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rx_done" Parent="packet_parser" Side="left" Width="30" X="-0.01875" Y="0.586111"/>
 <Port Color="#0000ff" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="rx_data" Parent="packet_parser" Side="left" Width="30" X="-0.01875" Y="0.786111"/>
 <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="frame_ready" Parent="packet_parser" Side="right" Width="30" X="0.98125" Y="0.128704"/>
 <Port Color="#6495ed" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="left_speed_reg" Parent="packet_parser" Side="right" Width="30" X="0.98125" Y="0.271296"/>
 <Port Color="#0000ff" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="right_speed_reg" Parent="packet_parser" Side="right" Width="30" X="0.98125" Y="0.413889"/>
 <Port Color="#a52a2a" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="right_dir_reg" Parent="packet_parser" Side="right" Width="30" X="0.98125" Y="0.699074"/>
 <Port Color="#b22222" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="left_dir_reg" Parent="packet_parser" Side="right" Width="30" X="0.98125" Y="0.556481"/>
 <Port Color="#b8860b" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="cmd" Parent="packet_parser" Side="right" Width="30" X="0.98125" Y="0.841667"/>
</Module>
