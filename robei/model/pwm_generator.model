<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="&#xa;    reg [PWM_BITS-1:0] pwm_counter;  // PWM计数器&#xa;    reg [6:0]clk_div_counter;             //分频计数器&#xa;    reg clk_slow;                    //分频后时钟,T为4ms&#xa;    &#xa;    //最大计数值 255&#xa;    localparam MAX_CNT = (1 &lt;&lt; PWM_BITS) - 1;&#xa;    &#xa;     // 时钟分频 (降低PWM频率，通常需要几百Hz到几kHz)&#xa;    always @(posedge clk or negedge rst_n ) begin&#xa;        if (!rst_n) begin&#xa;            clk_div_counter &lt;= 0;&#xa;            clk_slow &lt;= 0;&#xa;        end&#xa;       else begin&#xa;            if (clk_div_counter == CLK_DIV - 1) begin&#xa;                clk_div_counter &lt;= 0;&#xa;                clk_slow &lt;= ~clk_slow;  // 翻转&#xa;            end&#xa;            else begin&#xa;                clk_div_counter &lt;= clk_div_counter + 1'd1;&#xa;            end&#xa;        end&#xa;    end&#xa;    &#xa;    // PWM生成&#xa;    always @(posedge clk_slow or negedge rst_n) begin&#xa;        if (!rst_n) begin&#xa;            pwm_counter &lt;= 0;&#xa;            pwm_out &lt;= 1'b0;&#xa;        end&#xa;        else begin&#xa;            // 到最大值清零&#xa;            if (pwm_counter == MAX_CNT)&#xa;                pwm_counter &lt;= 0;&#xa;            else&#xa;                pwm_counter &lt;= pwm_counter + 1'd1;&#xa;            &#xa;            if (pwm_counter &lt; duty_cycle) begin&#xa;                pwm_out &lt;= 1'b1;&#xa;            end&#xa;            else begin&#xa;                pwm_out &lt;= 1'b0;&#xa;            end&#xa;        end&#xa;    end" Color="#d3d3d3" Comment="" Height="1080" Name="pwm_generator" Parameters="PWM_BITS = 8; //PWM精度 (8位 = 256级)&#xa;CLK_DIV = 100; //时钟分频，控制PWM频率&#xa;" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="pwm_generator" Side="left" Width="30" X="-0.01875" Y="0.236111"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="pwm_generator" Side="left" Width="30" X="-0.01875" Y="0.486111"/>
 <Port Color="#7fffd4" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="duty_cycle" Parent="pwm_generator" Side="left" Width="30" X="-0.01875" Y="0.736111"/>
 <Port Color="#bdb76b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="pwm_out" Parent="pwm_generator" Side="right" Width="30" X="0.98125" Y="0.486111"/>
</Module>
