<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="    // 电机方向控制信号生成&#xa;    localparam [1:0] &#xa;        MOTOR_STOP  = 2'b00,&#xa;        MOTOR_FWD   = 2'b01,&#xa;        MOTOR_BACK  = 2'b10;&#xa;&#xa;    always @(posedge clk) begin&#xa;        if (!rst_n) begin&#xa;            // 复位时全部关闭&#xa;            left_motor_go   &lt;= 1'b0;&#xa;            left_motor_back &lt;= 1'b0;&#xa;            right_motor_go  &lt;= 1'b0;&#xa;            right_motor_back &lt;= 1'b0;&#xa;        end&#xa;        else begin&#xa;            // 左电机控制译码&#xa;            case (left_motor_action)&#xa;                MOTOR_STOP: begin left_motor_go&lt;=0; left_motor_back&lt;=0; end&#xa;                MOTOR_FWD:  begin left_motor_go&lt;=1; left_motor_back&lt;=0; end&#xa;                MOTOR_BACK: begin left_motor_go&lt;=0; left_motor_back&lt;=1; end&#xa;                default:    begin left_motor_go&lt;=0; left_motor_back&lt;=0; end&#xa;            endcase&#xa;&#xa;            // 右电机控制译码&#xa;            case (right_motor_action)&#xa;                MOTOR_STOP: begin right_motor_go&lt;=0; right_motor_back&lt;=0; end&#xa;                MOTOR_FWD:  begin right_motor_go&lt;=1; right_motor_back&lt;=0; end&#xa;                MOTOR_BACK: begin right_motor_go&lt;=0; right_motor_back&lt;=1; end&#xa;                default:    begin right_motor_go&lt;=0; right_motor_back&lt;=0; end&#xa;            endcase&#xa;        end&#xa;    end" Color="#d3d3d3" Comment="" Height="1080" Name="motor_direction" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="motor_direction" Side="left" Width="30" X="-0.01875" Y="0.186111"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="motor_direction" Side="left" Width="30" X="-0.01875" Y="0.386111"/>
 <Port Color="#a52a2a" Connect="" Datasize="2" Datatype="wire" Description="" Height="30" Inout="input" Name="left_motor_action" Parent="motor_direction" Side="left" Width="30" X="-0.01875" Y="0.586111"/>
 <Port Color="#d2691e" Connect="" Datasize="2" Datatype="wire" Description="" Height="30" Inout="input" Name="right_motor_action" Parent="motor_direction" Side="left" Width="30" X="-0.01875" Y="0.786111"/>
 <Port Color="#dc143c" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="left_motor_go" Parent="motor_direction" Side="right" Width="30" X="0.98125" Y="0.186111"/>
 <Port Color="#b8860b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="left_motor_back" Parent="motor_direction" Side="right" Width="30" X="0.98125" Y="0.386111"/>
 <Port Color="#0000ff" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="right_motor_go" Parent="motor_direction" Side="right" Width="30" X="0.98125" Y="0.586111"/>
 <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="right_motor_back" Parent="motor_direction" Side="right" Width="30" X="0.98125" Y="0.786111"/>
</Module>
