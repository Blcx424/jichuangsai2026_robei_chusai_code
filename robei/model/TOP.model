<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="" Color="#d3d3d3" Comment="" Height="1643" Name="TOP" Parameters="" Parent="0" Type="model" Width="2212" X="0" Y="0">
 <Module Category="Current" Class="pwm_generator" Code="&#xa;    reg [PWM_BITS-1:0] pwm_counter;  /* PWM计数器*/&#xa;    reg [6:0]clk_div_counter;             /*分频计数器*/&#xa;    reg clk_slow;                    /*分频后时钟,T为4ms*/&#xa;    &#xa;    /*最大计数值 255*/&#xa;    localparam MAX_CNT = (1 &lt;&lt; PWM_BITS) - 1;&#xa;    &#xa;     // 时钟分频 (降低PWM频率，通常需要几百Hz到几kHz)&#xa;    always @(posedge clk or negedge rst_n ) begin&#xa;        if (!rst_n) begin&#xa;            clk_div_counter &lt;= 0;&#xa;            clk_slow &lt;= 0;&#xa;        end&#xa;       else begin&#xa;            if (clk_div_counter == CLK_DIV - 1) begin&#xa;                clk_div_counter &lt;= 0;&#xa;                clk_slow &lt;= ~clk_slow;  // 翻转&#xa;            end&#xa;            else begin&#xa;                clk_div_counter &lt;= clk_div_counter + 1'd1;&#xa;            end&#xa;        end&#xa;    end&#xa;    &#xa;    // PWM生成&#xa;    always @(posedge clk_slow or negedge rst_n) begin&#xa;        if (!rst_n) begin&#xa;            pwm_counter &lt;= 0;&#xa;            pwm_out &lt;= 1'b0;&#xa;        end&#xa;        else begin&#xa;            // 关键！！！到最大值清零&#xa;            if (pwm_counter == MAX_CNT)&#xa;                pwm_counter &lt;= 0;&#xa;            else&#xa;                pwm_counter &lt;= pwm_counter + 1'd1;&#xa;            &#xa;            if (pwm_counter &lt; duty_cycle) begin&#xa;                pwm_out &lt;= 1'b1;&#xa;            end&#xa;            else begin&#xa;                pwm_out &lt;= 1'b0;&#xa;            end&#xa;        end&#xa;    end" Color="aqua" Comment="" Height="293" Name="pwm_generatorL" Parameters="PWM_BITS = 8; //PWM精度 (8位 = 256级)&#xa;CLK_DIV = 100; //时钟分频，控制PWM频率&#xa;" Parent="TOP" Type="model" Width="262" X="1728.8" Y="134.588">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="pwm_generatorL" Side="left" Width="30" X="-0.114504" Y="0.197952"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="pwm_generatorL" Side="left" Width="30" X="-0.114504" Y="0.447099"/>
  <Port Color="#7fffd4" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="duty_cycle" Parent="pwm_generatorL" Side="left" Width="30" X="-0.114504" Y="0.696246"/>
  <Port Color="#bdb76b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="pwm_out" Parent="pwm_generatorL" Side="right" Width="30" X="0.885496" Y="0.447099"/>
 </Module>
 <Module Category="Current" Class="pwm_generator" Code="&#xa;    reg [PWM_BITS-1:0] pwm_counter;  /* PWM计数器*/&#xa;    reg [6:0]clk_div_counter;             /*分频计数器*/&#xa;    reg clk_slow;                    /*分频后时钟,T为4ms*/&#xa;    &#xa;    /*最大计数值 255*/&#xa;    localparam MAX_CNT = (1 &lt;&lt; PWM_BITS) - 1;&#xa;    &#xa;     // 时钟分频 (降低PWM频率，通常需要几百Hz到几kHz)&#xa;    always @(posedge clk or negedge rst_n ) begin&#xa;        if (!rst_n) begin&#xa;            clk_div_counter &lt;= 0;&#xa;            clk_slow &lt;= 0;&#xa;        end&#xa;       else begin&#xa;            if (clk_div_counter == CLK_DIV - 1) begin&#xa;                clk_div_counter &lt;= 0;&#xa;                clk_slow &lt;= ~clk_slow;  // 翻转&#xa;            end&#xa;            else begin&#xa;                clk_div_counter &lt;= clk_div_counter + 1'd1;&#xa;            end&#xa;        end&#xa;    end&#xa;    &#xa;    // PWM生成&#xa;    always @(posedge clk_slow or negedge rst_n) begin&#xa;        if (!rst_n) begin&#xa;            pwm_counter &lt;= 0;&#xa;            pwm_out &lt;= 1'b0;&#xa;        end&#xa;        else begin&#xa;            // 关键！！！到最大值清零&#xa;            if (pwm_counter == MAX_CNT)&#xa;                pwm_counter &lt;= 0;&#xa;            else&#xa;                pwm_counter &lt;= pwm_counter + 1'd1;&#xa;            &#xa;            if (pwm_counter &lt; duty_cycle) begin&#xa;                pwm_out &lt;= 1'b1;&#xa;            end&#xa;            else begin&#xa;                pwm_out &lt;= 1'b0;&#xa;            end&#xa;        end&#xa;    end" Color="aquamarine" Comment="" Height="293" Name="pwm_generatorR" Parameters="PWM_BITS = 8; //PWM精度 (8位 = 256级)&#xa;CLK_DIV = 100; //时钟分频，控制PWM频率&#xa;" Parent="TOP" Type="model" Width="265" X="1730.07" Y="482.316">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="pwm_generatorR" Side="left" Width="30" X="-0.113208" Y="0.197952"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="pwm_generatorR" Side="left" Width="30" X="-0.113208" Y="0.447099"/>
  <Port Color="#7fffd4" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="duty_cycle" Parent="pwm_generatorR" Side="left" Width="30" X="-0.113208" Y="0.696246"/>
  <Port Color="#bdb76b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="pwm_out" Parent="pwm_generatorR" Side="right" Width="30" X="0.886792" Y="0.447099"/>
 </Module>
 <Module Category="Current" Class="blue_tooth" Code="//parameter define&#xa;parameter CLK_FREQ = 50000000;               //系统时钟频率&#xa;parameter UART_BPS = 115200  ;               //串口波特率&#xa;localparam BAUD_CNT_MAX = CLK_FREQ/UART_BPS; //为得到指定波特率，对系统时钟计数BPS_CNT次&#xa;&#xa;assign at_pin = 1'b1;&#xa;&#xa;//reg define&#xa;reg          uart_rxd_d0;&#xa;reg          uart_rxd_d1;&#xa;reg          uart_rxd_d2;&#xa;reg          rx_flag    ;  //接收过程标志信号&#xa;reg  [3:0 ]  rx_cnt     ;  //接收数据计数器&#xa;reg  [15:0]  baud_cnt   ;  //波特率计数器&#xa;reg  [7:0 ]  rx_data_t  ;  //接收数据寄存器&#xa;&#xa;//wire define&#xa;wire        start_en;&#xa;&#xa;&#xa;//                 main code&#xa;&#xa;//捕获接收端口下降沿(起始位)，得到一个时钟周期的脉冲信号&#xa;assign start_en = uart_rxd_d2 &amp; (~uart_rxd_d1) &amp; (~rx_flag);&#xa;&#xa;//针对异步信号的同步处理&#xa;always @(posedge Clk or negedge Reset_n) begin&#xa;    if(!Reset_n) begin&#xa;        uart_rxd_d0 &lt;= 1'b0;&#xa;        uart_rxd_d1 &lt;= 1'b0;&#xa;        uart_rxd_d2 &lt;= 1'b0;&#xa;    end&#xa;    else begin&#xa;        uart_rxd_d0 &lt;= uart_rx;&#xa;        uart_rxd_d1 &lt;= uart_rxd_d0;&#xa;        uart_rxd_d2 &lt;= uart_rxd_d1;&#xa;    end&#xa;end&#xa;&#xa;//给接收标志赋值&#xa;always @(posedge Clk or negedge Reset_n) begin&#xa;    if(!Reset_n)&#xa;        rx_flag &lt;= 1'b0;&#xa;    else if(start_en)    //检测到起始位&#xa;        rx_flag &lt;= 1'b1; //接收过程中，标志信号rx_flag拉高&#xa;    //在停止位一半的时候，即接收过程结束，标志信号rx_flag拉低&#xa;    else if((rx_cnt == 4'd9) &amp;&amp; (baud_cnt == BAUD_CNT_MAX/2 - 1'b1))&#xa;        rx_flag &lt;= 1'b0;&#xa;    else&#xa;        rx_flag &lt;= rx_flag;&#xa;end       &#xa;&#xa;//波特率的计数器赋值&#xa;always @(posedge Clk or negedge Reset_n) begin&#xa;    if(!Reset_n)&#xa;        baud_cnt &lt;= 16'd0;&#xa;    else if(rx_flag) begin     //处于接收过程时，波特率计数器（baud_cnt）进行循环计数&#xa;        if(baud_cnt &lt; BAUD_CNT_MAX - 1'b1)&#xa;            baud_cnt &lt;= baud_cnt + 16'b1;&#xa;        else&#xa;            baud_cnt &lt;= 16'd0; //计数达到一个波特率周期后清零&#xa;    end   &#xa;    else&#xa;        baud_cnt &lt;= 16'd0;     //接收过程结束时计数器清零&#xa;end&#xa;&#xa;//对接收数据计数器（rx_cnt）进行赋值&#xa;always @(posedge Clk or negedge Reset_n) begin&#xa;    if(!Reset_n)&#xa;        rx_cnt &lt;= 4'd0;&#xa;    else if(rx_flag) begin                  //处于接收过程时rx_cnt才进行计数&#xa;        if(baud_cnt == BAUD_CNT_MAX - 1'b1) //当波特率计数器计数到一个波特率周期时&#xa;            rx_cnt &lt;= rx_cnt + 1'b1;        //接收数据计数器加1&#xa;        else&#xa;            rx_cnt &lt;= rx_cnt;&#xa;    end&#xa;    else&#xa;        rx_cnt &lt;= 4'd0;                     //接收过程结束时计数器清零&#xa;end       &#xa;&#xa;//根据rx_cnt来寄存rxd端口的数据&#xa;always @(posedge Clk or negedge Reset_n) begin&#xa;    if(!Reset_n)&#xa;        rx_data_t &lt;= 8'b0;&#xa;    else if(rx_flag) begin                           //系统处于接收过程时&#xa;        if(baud_cnt == BAUD_CNT_MAX/2 - 1'b1) begin  //判断baud_cnt是否计数到数据位的中间&#xa;           case(rx_cnt)&#xa;               4'd1 : rx_data_t[0] &lt;= uart_rxd_d2;   //寄存数据的最低位&#xa;               4'd2 : rx_data_t[1] &lt;= uart_rxd_d2;&#xa;               4'd3 : rx_data_t[2] &lt;= uart_rxd_d2;&#xa;               4'd4 : rx_data_t[3] &lt;= uart_rxd_d2;&#xa;               4'd5 : rx_data_t[4] &lt;= uart_rxd_d2;&#xa;               4'd6 : rx_data_t[5] &lt;= uart_rxd_d2;&#xa;               4'd7 : rx_data_t[6] &lt;= uart_rxd_d2;&#xa;               4'd8 : rx_data_t[7] &lt;= uart_rxd_d2;   //寄存数据的高低位&#xa;               default : ;&#xa;            endcase &#xa;        end&#xa;        else&#xa;            rx_data_t &lt;= rx_data_t;&#xa;    end&#xa;    else&#xa;        rx_data_t &lt;= 8'b0;&#xa;end       &#xa;&#xa;//给接收完成信号和接收到的数据赋值&#xa;always @(posedge Clk or negedge Reset_n) begin&#xa;    if(!Reset_n) begin&#xa;        Rx_Done &lt;= 1'b0;&#xa;        Rx_Data &lt;= 8'b0;&#xa;    end&#xa;    //当接收数据计数器计数到停止位，且baud_cnt计数到停止位的中间时&#xa;    else if(rx_cnt == 4'd9 &amp;&amp; baud_cnt == BAUD_CNT_MAX/2 - 1'b1) begin&#xa;        Rx_Done &lt;= 1'b1     ;  //拉高接收完成信号&#xa;        Rx_Data &lt;= rx_data_t;  //并对UART接收到的数据进行赋值&#xa;    end   &#xa;    else begin&#xa;        Rx_Done &lt;= 1'b0;&#xa;        Rx_Data &lt;= Rx_Data;&#xa;    end&#xa;end" Color="azure" Comment="" Height="359" Name="blue_tooth4" Parameters="" Parent="TOP" Type="model" Width="243" X="150.424" Y="376.493">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="Clk" Parent="blue_tooth4" Side="left" Width="30" X="-0.123457" Y="0.206128"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="Reset_n" Parent="blue_tooth4" Side="left" Width="30" X="-0.123457" Y="0.454039"/>
  <Port Color="#7fffd4" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="uart_rx" Parent="blue_tooth4" Side="left" Width="30" X="-0.123457" Y="0.70195"/>
  <Port Color="#ff1493" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="Rx_Done" Parent="blue_tooth4" Side="right" Width="30" X="0.876543" Y="0.206128"/>
  <Port Color="#0000ff" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="Rx_Data" Parent="blue_tooth4" Side="right" Width="30" X="0.876543" Y="0.454039"/>
  <Port Color="#7fff00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="at_pin" Parent="blue_tooth4" Side="right" Width="30" X="0.876543" Y="0.70195"/>
 </Module>
 <Module Category="Current" Class="packet_parser" Code="localparam [1:0]&#xa;        DIR_STOP  = 2'b00,&#xa;        DIR_FWD   = 2'b01,&#xa;        DIR_BACK  = 2'b10;&#xa;&#xa;    reg [7:0] rx_buffer [0:6];&#xa;    reg [2:0] byte_cnt;&#xa;    reg [1:0] rx_state;&#xa;    localparam [1:0]&#xa;        RX_IDLE      = 2'b00,&#xa;        RX_RECEIVE   = 2'b01,&#xa;        RX_PARSE     = 2'b10;&#xa;&#xa;    integer i;  // 用于for循环&#xa;&#xa;    // 测试信号（保留，不输出亦可）&#xa;    reg led_test_any;&#xa;    reg led_test_aa;&#xa;    &#xa;    reg connected;&#xa;&#xa;    // ========== 蓝牙连接状态管理 ==========&#xa;    always @(posedge clk or negedge rst_n) begin&#xa;        if (!rst_n) begin&#xa;            connected &lt;= 1'b0;&#xa;        end&#xa;        else begin&#xa;            if (frame_ready) begin&#xa;                connected &lt;= 1'b1;&#xa;            end&#xa;        end&#xa;    end&#xa;&#xa;    // ========== 蓝牙帧解析状态机 ==========&#xa;    always @(posedge clk or negedge rst_n) begin&#xa;        if (!rst_n) begin&#xa;            rx_state &lt;= RX_IDLE;&#xa;            byte_cnt &lt;= 3'd0;&#xa;            frame_ready &lt;= 1'b0;&#xa;            for (i = 0; i &lt; 7; i = i + 1) begin&#xa;                rx_buffer[i] &lt;= 8'h0;&#xa;            end&#xa;            left_speed_reg  &lt;= 8'd0;&#xa;            right_speed_reg &lt;= 8'd0;&#xa;            left_dir_reg    &lt;= DIR_STOP;&#xa;            right_dir_reg   &lt;= DIR_STOP;&#xa;            cmd &lt;= 8'd0;&#xa;        end&#xa;        else begin&#xa;            case (rx_state)&#xa;                RX_IDLE: begin&#xa;                    frame_ready &lt;= 1'b0;&#xa;                    if (rx_done &amp;&amp; rx_data == 8'hAA) begin&#xa;                        rx_buffer[0] &lt;= rx_data;&#xa;                        byte_cnt &lt;= 3'd1;&#xa;                        rx_state &lt;= RX_RECEIVE;&#xa;                        led_test_aa &lt;= 1'b1;&#xa;                    end&#xa;                end&#xa;&#xa;                RX_RECEIVE: begin&#xa;                    if (rx_done) begin&#xa;                        case (byte_cnt)&#xa;                            3'd1: rx_buffer[1] &lt;= rx_data;&#xa;                            3'd2: rx_buffer[2] &lt;= rx_data;&#xa;                            3'd3: rx_buffer[3] &lt;= rx_data;&#xa;                            3'd4: rx_buffer[4] &lt;= rx_data;&#xa;                            3'd5: rx_buffer[5] &lt;= rx_data;&#xa;                            3'd6: rx_buffer[6] &lt;= rx_data;&#xa;                        endcase&#xa;&#xa;                        if (byte_cnt == 3'd6) begin&#xa;                            if (rx_data == 8'h55) begin&#xa;                            // 关键修改：在此直接输出 cmd与frame_ready同步 &#xa;                                cmd &lt;= rx_buffer[1]; // 新增：让cmd更新&#xa;                                frame_ready &lt;= 1'b1;&#xa;                                rx_state &lt;= RX_PARSE;&#xa;                                led_test_any &lt;= 1'b1;&#xa;                            end&#xa;                        end&#xa;                        else begin&#xa;                            byte_cnt &lt;= byte_cnt + 3'd1;&#xa;                        end&#xa;                    end&#xa;                end&#xa;&#xa;                RX_PARSE: begin&#xa;                    left_speed_reg &lt;= rx_buffer[2];&#xa;                    right_speed_reg &lt;= rx_buffer[3];&#xa;&#xa;                    case (rx_buffer[4])&#xa;                        8'h01: left_dir_reg &lt;= DIR_FWD;&#xa;                        8'h02: left_dir_reg &lt;= DIR_BACK;&#xa;                        default: left_dir_reg &lt;= DIR_STOP;&#xa;                    endcase&#xa;&#xa;                    case (rx_buffer[5])&#xa;                        8'h01: right_dir_reg &lt;= DIR_FWD;&#xa;                        8'h02: right_dir_reg &lt;= DIR_BACK;&#xa;                        default: right_dir_reg &lt;= DIR_STOP;&#xa;                    endcase&#xa;&#xa;                    &#xa;                    frame_ready &lt;= 1'b0;&#xa;                    rx_state &lt;= RX_IDLE;&#xa;                end&#xa;&#xa;                default: rx_state &lt;= RX_IDLE;&#xa;            endcase&#xa;        end&#xa;    end" Color="azure" Comment="" Height="612" Name="packet_parser4" Parameters="" Parent="TOP" Type="model" Width="246" X="669.278" Y="811.707">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="packet_parser4" Side="left" Width="30" X="-0.121951" Y="0.174837"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="packet_parser4" Side="left" Width="30" X="-0.121951" Y="0.374183"/>
  <Port Color="#ff1493" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rx_done" Parent="packet_parser4" Side="left" Width="30" X="-0.121951" Y="0.573529"/>
  <Port Color="#0000ff" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="rx_data" Parent="packet_parser4" Side="left" Width="30" X="-0.121951" Y="0.772876"/>
  <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="frame_ready" Parent="packet_parser4" Side="right" Width="30" X="0.878049" Y="0.117647"/>
  <Port Color="#6495ed" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="left_speed_reg" Parent="packet_parser4" Side="right" Width="30" X="0.878049" Y="0.401961"/>
  <Port Color="#0000ff" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="right_speed_reg" Parent="packet_parser4" Side="right" Width="30" X="0.878049" Y="0.544118"/>
  <Port Color="#a52a2a" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="right_dir_reg" Parent="packet_parser4" Side="right" Width="30" X="0.878049" Y="0.828431"/>
  <Port Color="#b22222" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="left_dir_reg" Parent="packet_parser4" Side="right" Width="30" X="0.878049" Y="0.686275"/>
  <Port Color="#b8860b" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="cmd" Parent="packet_parser4" Side="right" Width="30" X="0.878049" Y="0.259804"/>
 </Module>
 <Module Category="Current" Class="high_level_control" Code="localparam [1:0]&#xa;        TOP_MODE_STOP     = 2'b00,&#xa;        TOP_MODE_REMOTE   = 2'b01,&#xa;        TOP_MODE_TRACK_AVOID = 2'b10,&#xa;        TOP_MODE_TRACK    = 2'b11;&#xa;&#xa;    // 生成 frame_ready 上升沿&#xa;    reg frame_ready_dly;&#xa;    wire frame_ready_posedge;&#xa;    always @(posedge clk or negedge rst_n) begin&#xa;        if (!rst_n)&#xa;            frame_ready_dly &lt;= 1'b0;&#xa;        else&#xa;            frame_ready_dly &lt;= frame_ready;&#xa;    end&#xa;    assign frame_ready_posedge = frame_ready &amp;&amp; !frame_ready_dly;&#xa;&#xa;    always @(posedge clk or negedge rst_n) begin&#xa;        if (!rst_n) begin&#xa;            top_work_mode &lt;= TOP_MODE_STOP;&#xa;        end&#xa;        else begin&#xa;            if (frame_ready_posedge) begin&#xa;                case (cmd)&#xa;                    8'h01: top_work_mode &lt;= TOP_MODE_REMOTE;&#xa;                    8'h02: top_work_mode &lt;= TOP_MODE_TRACK_AVOID;&#xa;                    8'h03: top_work_mode &lt;= TOP_MODE_TRACK;&#xa;                    default: top_work_mode &lt;= TOP_MODE_STOP;&#xa;                endcase&#xa;            end&#xa;        end&#xa;    end&#xa;" Color="beige" Comment="" Height="316" Name="high_level_control5" Parameters="" Parent="TOP" Type="model" Width="246" X="667.814" Y="349.178">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="high_level_control5" Side="left" Width="30" X="-0.121951" Y="0.151899"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="high_level_control5" Side="left" Width="30" X="-0.121951" Y="0.351266"/>
  <Port Color="#b8860b" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="cmd" Parent="high_level_control5" Side="left" Width="30" X="-0.121951" Y="0.75"/>
  <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="frame_ready" Parent="high_level_control5" Side="left" Width="30" X="-0.121951" Y="0.550633"/>
  <Port Color="#9acd32" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="top_work_mode" Parent="high_level_control5" Side="right" Width="30" X="0.878049" Y="0.452532"/>
 </Module>
 <Module Category="Current" Class="motor_control" Code="// 电机动作状态编码&#xa;    localparam [1:0] &#xa;        MOTOR_STOP  = 2'b00,&#xa;        MOTOR_FWD   = 2'b01,&#xa;        MOTOR_BACK  = 2'b10;&#xa;&#xa;    // 原有工作模式&#xa;    reg [1:0] work_mode;&#xa;    localparam [1:0]&#xa;        MODE_LINE_FOLLOW = 2'b00,&#xa;        MODE_AVOID       = 2'b01;&#xa;&#xa;    // 脱线处理状态&#xa;    reg [31:0] lost_timer;&#xa;    reg [1:0] lost_state;&#xa;    localparam [1:0]&#xa;        LOST_IDLE      = 2'b00,&#xa;        LOST_PAUSE     = 2'b01,&#xa;        LOST_BACKWARD  = 2'b10;&#xa;&#xa;    localparam [31:0] &#xa;        CLK_FREQ = 50_000_000,&#xa;        PAUSE_TIME = 2 * CLK_FREQ,&#xa;        BACKWARD_TIME = 1 * CLK_FREQ;&#xa;&#xa;    wire [1:0] sensor_state = {sensor_left, sensor_right};&#xa;    wire [1:0] ir_state = {ir_left, ir_right};&#xa;&#xa;    // 高层模式常量（便于case）&#xa;    localparam [1:0]&#xa;        TOP_MODE_STOP       = 2'b00,&#xa;        TOP_MODE_REMOTE     = 2'b01,&#xa;        TOP_MODE_TRACK_AVOID = 2'b10,&#xa;        TOP_MODE_TRACK      = 2'b11;&#xa;&#xa;    // ========== 原有工作模式切换 ==========&#xa;    always @(posedge clk or negedge rst_n) begin&#xa;        if (!rst_n) begin&#xa;            work_mode &lt;= MODE_LINE_FOLLOW;&#xa;        end&#xa;        else begin&#xa;            if (top_work_mode == TOP_MODE_TRACK_AVOID || top_work_mode == TOP_MODE_TRACK) begin&#xa;                if (ir_state != 2'b11) begin&#xa;                    work_mode &lt;= MODE_AVOID;&#xa;                end&#xa;                else if (ir_state == 2'b11) begin&#xa;                    work_mode &lt;= MODE_LINE_FOLLOW;&#xa;                end&#xa;            end&#xa;        end&#xa;    end&#xa;&#xa;    // ========== 主控逻辑 ==========&#xa;    always @(posedge clk or negedge rst_n) begin&#xa;        if (!rst_n) begin&#xa;            pwm_duty_left  &lt;= 8'd0;&#xa;            pwm_duty_right &lt;= 8'd0;&#xa;            left_motor_action  &lt;= MOTOR_STOP;&#xa;            right_motor_action &lt;= MOTOR_STOP;&#xa;            lost_timer &lt;= 0;&#xa;            lost_state &lt;= LOST_IDLE;&#xa;        end&#xa;        else begin&#xa;            case (top_work_mode)&#xa;                TOP_MODE_STOP: begin&#xa;                    pwm_duty_left  &lt;= 8'd0;&#xa;                    pwm_duty_right &lt;= 8'd0;&#xa;                    left_motor_action  &lt;= MOTOR_STOP;&#xa;                    right_motor_action &lt;= MOTOR_STOP;&#xa;                    lost_timer &lt;= 0;&#xa;                    lost_state &lt;= LOST_IDLE;&#xa;                end&#xa;&#xa;                TOP_MODE_REMOTE: begin&#xa;                    pwm_duty_left &lt;= (left_speed_reg == 8'h00) ? 8'd0 : left_speed_reg;&#xa;                    pwm_duty_right &lt;= (right_speed_reg == 8'h00) ? 8'd0 : right_speed_reg;&#xa;                    left_motor_action &lt;= left_dir_reg;&#xa;                    right_motor_action &lt;= right_dir_reg;&#xa;                    lost_timer &lt;= 0;&#xa;                    lost_state &lt;= LOST_IDLE;&#xa;                end&#xa;&#xa;                TOP_MODE_TRACK_AVOID: begin&#xa;                    if (work_mode == MODE_AVOID) begin&#xa;                        pwm_duty_left  &lt;= 8'd150;&#xa;                        pwm_duty_right &lt;= 8'd150;&#xa;                        case (ir_state)&#xa;                            2'b00: begin&#xa;                                left_motor_action  &lt;= MOTOR_BACK;&#xa;                                right_motor_action &lt;= MOTOR_BACK;&#xa;                            end&#xa;                            2'b01: begin&#xa;                                left_motor_action  &lt;= MOTOR_FWD;&#xa;                                right_motor_action &lt;= MOTOR_STOP;&#xa;                            end&#xa;                            2'b10: begin&#xa;                                left_motor_action  &lt;= MOTOR_STOP;&#xa;                                right_motor_action &lt;= MOTOR_FWD;&#xa;                            end&#xa;                            2'b11: begin&#xa;                                left_motor_action  &lt;= MOTOR_FWD;&#xa;                                right_motor_action &lt;= MOTOR_FWD;&#xa;                            end&#xa;                        endcase&#xa;                    end&#xa;                    else if (work_mode == MODE_LINE_FOLLOW) begin&#xa;                        if (lost_state == LOST_IDLE) begin&#xa;                            case (sensor_state)&#xa;                                2'b11: begin&#xa;                                    pwm_duty_left  &lt;= 8'd110;&#xa;                                    pwm_duty_right &lt;= 8'd110;&#xa;                                    left_motor_action  &lt;= MOTOR_FWD;&#xa;                                    right_motor_action &lt;= MOTOR_FWD;&#xa;                                end&#xa;                                2'b01: begin&#xa;                                    pwm_duty_left  &lt;= 8'd150;&#xa;                                    pwm_duty_right &lt;= 8'd40;&#xa;                                    left_motor_action  &lt;= MOTOR_FWD;&#xa;                                    right_motor_action &lt;= MOTOR_FWD;&#xa;                                end&#xa;                                2'b10: begin&#xa;                                    pwm_duty_left  &lt;= 8'd40;&#xa;                                    pwm_duty_right &lt;= 8'd150;&#xa;                                    left_motor_action &lt;= MOTOR_FWD;&#xa;                                    right_motor_action &lt;= MOTOR_FWD;&#xa;                                end&#xa;                                2'b00: begin&#xa;                                    pwm_duty_left  &lt;= 8'd110;&#xa;                                    pwm_duty_right &lt;= 8'd110;&#xa;                                    left_motor_action  &lt;= MOTOR_FWD;&#xa;                                    right_motor_action &lt;= MOTOR_FWD;&#xa;                                end&#xa;                            endcase&#xa;                        end&#xa;                        else if (lost_state == LOST_PAUSE) begin&#xa;                            lost_timer &lt;= lost_timer + 1;&#xa;                            pwm_duty_left  &lt;= 8'd0;&#xa;                            pwm_duty_right &lt;= 8'd0;&#xa;                            left_motor_action  &lt;= MOTOR_STOP;&#xa;                            right_motor_action &lt;= MOTOR_STOP;&#xa;                            if (lost_timer >= PAUSE_TIME) begin&#xa;                                lost_timer &lt;= 0;&#xa;                                lost_state &lt;= LOST_BACKWARD;&#xa;                            end&#xa;                        end&#xa;                        else if (lost_state == LOST_BACKWARD) begin&#xa;                            lost_timer &lt;= lost_timer + 1;&#xa;                            pwm_duty_left  &lt;= 8'd120;&#xa;                            pwm_duty_right &lt;= 8'd120;&#xa;                            left_motor_action  &lt;= MOTOR_BACK;&#xa;                            right_motor_action &lt;= MOTOR_BACK;&#xa;                            if (lost_timer >= BACKWARD_TIME) begin&#xa;                                lost_timer &lt;= 0;&#xa;                                lost_state &lt;= LOST_IDLE;&#xa;                            end&#xa;                        end&#xa;                    end&#xa;                end&#xa;&#xa;                TOP_MODE_TRACK: begin&#xa;                    if (lost_state == LOST_IDLE) begin&#xa;                        case (sensor_state)&#xa;                            2'b11: begin&#xa;                                pwm_duty_left  &lt;= 8'd110;&#xa;                                pwm_duty_right &lt;= 8'd110;&#xa;                                left_motor_action  &lt;= MOTOR_FWD;&#xa;                                right_motor_action &lt;= MOTOR_FWD;&#xa;                            end&#xa;                            2'b01: begin&#xa;                                pwm_duty_left  &lt;= 8'd150;&#xa;                                pwm_duty_right &lt;= 8'd40;&#xa;                                left_motor_action  &lt;= MOTOR_FWD;&#xa;                                right_motor_action &lt;= MOTOR_FWD;&#xa;                            end&#xa;                            2'b10: begin&#xa;                                pwm_duty_left  &lt;= 8'd40;&#xa;                                pwm_duty_right &lt;= 8'd150;&#xa;                                left_motor_action &lt;= MOTOR_FWD;&#xa;                                right_motor_action &lt;= MOTOR_FWD;&#xa;                            end&#xa;                            2'b00: begin&#xa;                                pwm_duty_left  &lt;= 8'd110;&#xa;                                pwm_duty_right &lt;= 8'd110;&#xa;                                left_motor_action  &lt;= MOTOR_FWD;&#xa;                                right_motor_action &lt;= MOTOR_FWD;&#xa;                            end&#xa;                        endcase&#xa;                    end&#xa;                    else if (lost_state == LOST_PAUSE) begin&#xa;                        lost_timer &lt;= lost_timer + 1;&#xa;                        pwm_duty_left  &lt;= 8'd0;&#xa;                        pwm_duty_right &lt;= 8'd0;&#xa;                        left_motor_action  &lt;= MOTOR_STOP;&#xa;                        right_motor_action &lt;= MOTOR_STOP;&#xa;                        if (lost_timer >= PAUSE_TIME) begin&#xa;                            lost_timer &lt;= 0;&#xa;                            lost_state &lt;= LOST_BACKWARD;&#xa;                        end&#xa;                    end&#xa;                    else if (lost_state == LOST_BACKWARD) begin&#xa;                        lost_timer &lt;= lost_timer + 1;&#xa;                        pwm_duty_left  &lt;= 8'd120;&#xa;                        pwm_duty_right &lt;= 8'd120;&#xa;                        left_motor_action  &lt;= MOTOR_BACK;&#xa;                        right_motor_action &lt;= MOTOR_BACK;&#xa;                        if (lost_timer >= BACKWARD_TIME) begin&#xa;                            lost_timer &lt;= 0;&#xa;                            lost_state &lt;= LOST_IDLE;&#xa;                        end&#xa;                    end&#xa;                end&#xa;            endcase&#xa;        end&#xa;    end" Color="bisque" Comment="" Height="1064" Name="motor_control6" Parameters="" Parent="TOP" Type="model" Width="353" X="1084.79" Y="369.752">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="motor_control6" Side="left" Width="30" X="-0.0849858" Y="0.068609"/>
  <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="motor_control6" Side="left" Width="30" X="-0.0849858" Y="0.151316"/>
  <Port Color="#9acd32" Connect="" Datasize="2" Datatype="wire" Description="" Height="30" Inout="input" Name="top_work_mode" Parent="motor_control6" Side="left" Width="30" X="-0.0849858" Y="0.234023"/>
  <Port Color="#e9967a" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="sensor_left" Parent="motor_control6" Side="left" Width="30" X="-0.0849858" Y="0.316729"/>
  <Port Color="#cd5c5c" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="sensor_right" Parent="motor_control6" Side="left" Width="30" X="-0.0849858" Y="0.399436"/>
  <Port Color="#556b2f" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="ir_left" Parent="motor_control6" Side="left" Width="30" X="-0.0849858" Y="0.482143"/>
  <Port Color="#006400" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="ir_right" Parent="motor_control6" Side="left" Width="30" X="-0.0849858" Y="0.56485"/>
  <Port Color="#6495ed" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="left_speed_reg" Parent="motor_control6" Side="left" Width="30" X="-0.0849858" Y="0.647556"/>
  <Port Color="#0000ff" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="right_speed_reg" Parent="motor_control6" Side="left" Width="30" X="-0.0849858" Y="0.730263"/>
  <Port Color="#b22222" Connect="" Datasize="2" Datatype="wire" Description="" Height="30" Inout="input" Name="left_dir_reg" Parent="motor_control6" Side="left" Width="30" X="-0.0849858" Y="0.81297"/>
  <Port Color="#a52a2a" Connect="" Datasize="2" Datatype="wire" Description="" Height="30" Inout="input" Name="right_dir_reg" Parent="motor_control6" Side="left" Width="30" X="-0.0849858" Y="0.895677"/>
  <Port Color="#7fffd4" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="pwm_duty_left" Parent="motor_control6" Side="right" Width="30" X="0.915014" Y="0.18515"/>
  <Port Color="#7fffd4" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="pwm_duty_right" Parent="motor_control6" Side="right" Width="30" X="0.915014" Y="0.384398"/>
  <Port Color="#a52a2a" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="left_motor_action" Parent="motor_control6" Side="right" Width="30" X="0.915014" Y="0.583647"/>
  <Port Color="#d2691e" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="right_motor_action" Parent="motor_control6" Side="right" Width="30" X="0.915014" Y="0.782895"/>
 </Module>
 <Module Category="Current" Class="motor_direction" Code="localparam [1:0] &#xa;        MOTOR_STOP  = 2'b00,&#xa;        MOTOR_FWD   = 2'b01,&#xa;        MOTOR_BACK  = 2'b10;&#xa;&#xa;    always @(posedge clk) begin&#xa;        if (!rst_n) begin&#xa;            left_motor_go   &lt;= 1'b0;&#xa;            left_motor_back &lt;= 1'b0;&#xa;            right_motor_go  &lt;= 1'b0;&#xa;            right_motor_back &lt;= 1'b0;&#xa;        end&#xa;        else begin&#xa;            case (left_motor_action)&#xa;                MOTOR_STOP: begin left_motor_go&lt;=0; left_motor_back&lt;=0; end&#xa;                MOTOR_FWD:  begin left_motor_go&lt;=1; left_motor_back&lt;=0; end&#xa;                MOTOR_BACK: begin left_motor_go&lt;=0; left_motor_back&lt;=1; end&#xa;                default:    begin left_motor_go&lt;=0; left_motor_back&lt;=0; end&#xa;            endcase&#xa;&#xa;            case (right_motor_action)&#xa;                MOTOR_STOP: begin right_motor_go&lt;=0; right_motor_back&lt;=0; end&#xa;                MOTOR_FWD:  begin right_motor_go&lt;=1; right_motor_back&lt;=0; end&#xa;                MOTOR_BACK: begin right_motor_go&lt;=0; right_motor_back&lt;=1; end&#xa;                default:    begin right_motor_go&lt;=0; right_motor_back&lt;=0; end&#xa;            endcase&#xa;        end&#xa;    end" Color="#d3d3d3" Comment="" Height="555" Name="motor_direction7" Parameters="" Parent="TOP" Type="model" Width="263" X="1727.49" Y="836.014">
