  <Port Color="#dc143c" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="left_motor_go" Parent="motor_direction7" Side="right" Width="30" X="0.885932" Y="0.172973"/>
  <Port Color="#b8860b" Connect="" Datasize="1" Datatype="reg" Description="" Height="30" Inout="output" Name="left_motor_back" Parent="motor_direction7" Side="right" Width="30" X="0.885932" Y="0.372973"/>
