<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="    // 系统顶层工作模式定义&#xa;    localparam [1:0]&#xa;        TOP_MODE_STOP     = 2'b00,&#xa;        TOP_MODE_REMOTE   = 2'b01,&#xa;        TOP_MODE_TRACK_AVOID = 2'b10,&#xa;        TOP_MODE_TRACK    = 2'b11;&#xa;&#xa;    // 生成 frame_ready 上升沿&#xa;    // 将 frame_ready 打一拍，用于上升沿检测&#xa;    reg frame_ready_dly;&#xa;    wire frame_ready_posedge;&#xa;    &#xa;    always @(posedge clk or negedge rst_n) begin&#xa;        if (!rst_n)&#xa;            frame_ready_dly &lt;= 1'b0;&#xa;        else&#xa;            frame_ready_dly &lt;= frame_ready;&#xa;    end&#xa;    &#xa;    //frame_ready 的上升沿脉冲&#xa;    assign frame_ready_posedge = frame_ready &amp;&amp; !frame_ready_dly;&#xa;&#xa;    // 根据蓝牙接收到的命令字节 cmd 切换工作模式&#xa;    always @(posedge clk or negedge rst_n) begin&#xa;        if (!rst_n) begin&#xa;            top_work_mode &lt;= TOP_MODE_STOP;&#xa;        end&#xa;        else begin&#xa;            if (frame_ready_posedge) begin&#xa;                case (cmd)&#xa;                    // 遥控模式&#xa;                    8'h01: top_work_mode &lt;= TOP_MODE_REMOTE;&#xa;                    // 循迹+避障模式&#xa;                    8'h02: top_work_mode &lt;= TOP_MODE_TRACK_AVOID;&#xa;                    // 纯循迹模式&#xa;                    8'h03: top_work_mode &lt;= TOP_MODE_TRACK;&#xa;                    // 无效命令或停止命令，进入停止模式&#xa;                    default: top_work_mode &lt;= TOP_MODE_STOP;&#xa;                endcase&#xa;            end&#xa;        end&#xa;    end" Color="#d3d3d3" Comment="" Height="1080" Name="high_level_control" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="high_level_control" Side="left" Width="30" X="-0.01875" Y="0.186111"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="high_level_control" Side="left" Width="30" X="-0.01875" Y="0.386111"/>
 <Port Color="#b8860b" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="cmd" Parent="high_level_control" Side="left" Width="30" X="-0.01875" Y="0.786111"/>
 <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="frame_ready" Parent="high_level_control" Side="left" Width="30" X="-0.01875" Y="0.586111"/>
 <Port Color="#9acd32" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="top_work_mode" Parent="high_level_control" Side="right" Width="30" X="0.98125" Y="0.486111"/>
</Module>
