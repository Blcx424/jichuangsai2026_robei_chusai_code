<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="    // 电机动作状态编码&#xa;    localparam [1:0] &#xa;        MOTOR_STOP  = 2'b00,&#xa;        MOTOR_FWD   = 2'b01,&#xa;        MOTOR_BACK  = 2'b10;&#xa;&#xa;    // 原工作模式：循迹和避障&#xa;    reg [1:0] work_mode;&#xa;    localparam [1:0]&#xa;        MODE_LINE_FOLLOW = 2'b00,&#xa;        MODE_AVOID       = 2'b01;&#xa;&#xa;    // 脱线处理状态及时间参数&#xa;    reg [31:0] lost_timer;&#xa;    reg [1:0] lost_state;&#xa;    localparam [1:0]&#xa;        LOST_IDLE      = 2'b00,  // 未脱线&#xa;        LOST_PAUSE     = 2'b01,  // 脱线暂停，等待一段时间&#xa;        LOST_BACKWARD  = 2'b10;  // 脱线后退一小段&#xa;&#xa;    localparam [31:0] &#xa;        CLK_FREQ = 50_000_000,          // 时钟频率 50MHz&#xa;        PAUSE_TIME = 2 * CLK_FREQ,      // 暂停 2 秒&#xa;        BACKWARD_TIME = 1 * CLK_FREQ;   // 后退 1 秒&#xa;&#xa;    // 将两个红外循迹传感器和两个红外避障传感器拼接成 2bit 信号，方便 case 判断&#xa;    wire [1:0] sensor_state = {sensor_left, sensor_right};  //循迹&#xa;    wire [1:0] ir_state = {ir_left, ir_right};              //避障&#xa;&#xa;    // 顶层模式常量&#xa;    localparam [1:0]&#xa;        TOP_MODE_STOP       = 2'b00,&#xa;        TOP_MODE_REMOTE     = 2'b01,&#xa;        TOP_MODE_TRACK_AVOID = 2'b10,&#xa;        TOP_MODE_TRACK      = 2'b11;&#xa;&#xa;    // ========== 原有工作模式切换（循迹 / 避障） ==========&#xa;    // 只在巡线相关模式下才切换，遥控或停止时不处理&#xa;    always @(posedge clk or negedge rst_n) begin&#xa;        if (!rst_n) begin&#xa;            work_mode &lt;= MODE_LINE_FOLLOW;&#xa;        end&#xa;        else begin&#xa;            if (top_work_mode == TOP_MODE_TRACK_AVOID || top_work_mode == TOP_MODE_TRACK) begin&#xa;                // 有障碍物进入避障模式&#xa;                if (ir_state != 2'b11) begin&#xa;                    work_mode &lt;= MODE_AVOID;&#xa;                end&#xa;                // 无障碍物切回循迹模式&#xa;                else if (ir_state == 2'b11) begin&#xa;                    work_mode &lt;= MODE_LINE_FOLLOW;&#xa;                end&#xa;            end&#xa;        end&#xa;    end&#xa;&#xa;    // ========== 主控逻辑 ==========&#xa;    always @(posedge clk or negedge rst_n) begin&#xa;        if (!rst_n) begin&#xa;            pwm_duty_left  &lt;= 8'd0;&#xa;            pwm_duty_right &lt;= 8'd0;&#xa;            left_motor_action  &lt;= MOTOR_STOP;&#xa;            right_motor_action &lt;= MOTOR_STOP;&#xa;            lost_timer &lt;= 0;&#xa;            lost_state &lt;= LOST_IDLE;&#xa;        end&#xa;        else begin&#xa;            case (top_work_mode)&#xa;                // 停止模式：电机全停，累加器清零&#xa;                TOP_MODE_STOP: begin&#xa;                    pwm_duty_left  &lt;= 8'd0;&#xa;                    pwm_duty_right &lt;= 8'd0;&#xa;                    left_motor_action  &lt;= MOTOR_STOP;&#xa;                    right_motor_action &lt;= MOTOR_STOP;&#xa;                    lost_timer &lt;= 0;&#xa;                    lost_state &lt;= LOST_IDLE;&#xa;                end&#xa;&#xa;                // 遥控模式：直接使用 packet_parser 解析出的速度与方向&#xa;                TOP_MODE_REMOTE: begin&#xa;                    // 速度为 0 时强制输出 0，否则直接映射&#xa;                    pwm_duty_left &lt;= (left_speed_reg == 8'h00) ? 8'd0 : left_speed_reg;&#xa;                    pwm_duty_right &lt;= (right_speed_reg == 8'h00) ? 8'd0 : right_speed_reg;&#xa;                    left_motor_action &lt;= left_dir_reg;&#xa;                    right_motor_action &lt;= right_dir_reg;&#xa;                    lost_timer &lt;= 0;&#xa;                    lost_state &lt;= LOST_IDLE;&#xa;                end&#xa;&#xa;                // 循迹+避障模式&#xa;                TOP_MODE_TRACK_AVOID: begin&#xa;                    if (work_mode == MODE_AVOID) begin&#xa;                        // 避障：固定较快速度，根据红外状态转向或后退&#xa;                        pwm_duty_left  &lt;= 8'd150;&#xa;                        pwm_duty_right &lt;= 8'd150;&#xa;                        case (ir_state)&#xa;                            // 两侧均有障碍，后退&#xa;                            2'b00: begin&#xa;                                left_motor_action  &lt;= MOTOR_BACK;&#xa;                                right_motor_action &lt;= MOTOR_BACK;&#xa;                            end&#xa;                            // 左侧有障碍，左轮转，右轮停&#xa;                            2'b01: begin&#xa;                                left_motor_action  &lt;= MOTOR_FWD;&#xa;                                right_motor_action &lt;= MOTOR_STOP;&#xa;                            end&#xa;                            // 右侧有障碍，右轮转，左轮停&#xa;                            2'b10: begin&#xa;                                left_motor_action  &lt;= MOTOR_STOP;&#xa;                                right_motor_action &lt;= MOTOR_FWD;&#xa;                            end&#xa;                            // 无障碍，前进&#xa;                            2'b11: begin&#xa;                                left_motor_action  &lt;= MOTOR_FWD;&#xa;                                right_motor_action &lt;= MOTOR_FWD;&#xa;                            end&#xa;                        endcase&#xa;                    end&#xa;                    else if (work_mode == MODE_LINE_FOLLOW) begin&#xa;                        // 循迹部分，未脱线时根据传感器差值调整左右速度&#xa;                        if (lost_state == LOST_IDLE) begin&#xa;                            case (sensor_state)&#xa;                                // 两个传感器都检测到线，直行&#xa;                                2'b11: begin&#xa;                                    pwm_duty_left  &lt;= 8'd110;&#xa;                                    pwm_duty_right &lt;= 8'd110;&#xa;                                    left_motor_action  &lt;= MOTOR_FWD;&#xa;                                    right_motor_action &lt;= MOTOR_FWD;&#xa;                                end&#xa;                                // 左偏：右轮加快，左轮减慢&#xa;                                2'b01: begin&#xa;                                    pwm_duty_left  &lt;= 8'd150;&#xa;                                    pwm_duty_right &lt;= 8'd40;&#xa;                                    left_motor_action  &lt;= MOTOR_FWD;&#xa;                                    right_motor_action &lt;= MOTOR_FWD;&#xa;                                end&#xa;                                // 右偏：左轮加快，右轮减慢&#xa;                                2'b10: begin&#xa;                                    pwm_duty_left  &lt;= 8'd40;&#xa;                                    pwm_duty_right &lt;= 8'd150;&#xa;                                    left_motor_action &lt;= MOTOR_FWD;&#xa;                                    right_motor_action &lt;= MOTOR_FWD;&#xa;                                end&#xa;                                // 全脱线时继续保持直行，依赖后续脱线状态机处理&#xa;                                2'b00: begin&#xa;                                    pwm_duty_left  &lt;= 8'd110;&#xa;                                    pwm_duty_right &lt;= 8'd110;&#xa;                                    left_motor_action  &lt;= MOTOR_FWD;&#xa;                                    right_motor_action &lt;= MOTOR_FWD;&#xa;                                end&#xa;                            endcase&#xa;                        end&#xa;                        else if (lost_state == LOST_PAUSE) begin&#xa;                            &#xa;                            lost_timer &lt;= lost_timer + 1;&#xa;                            pwm_duty_left  &lt;= 8'd0;&#xa;                            pwm_duty_right &lt;= 8'd0;&#xa;                            left_motor_action  &lt;= MOTOR_STOP;&#xa;                            right_motor_action &lt;= MOTOR_STOP;&#xa;                            if (lost_timer >= PAUSE_TIME) begin&#xa;                                lost_timer &lt;= 0;&#xa;                                lost_state &lt;= LOST_BACKWARD;&#xa;                            end&#xa;                        end&#xa;                        else if (lost_state == LOST_BACKWARD) begin&#xa;                         &#xa;                            lost_timer &lt;= lost_timer + 1;&#xa;                            pwm_duty_left  &lt;= 8'd120;&#xa;                            pwm_duty_right &lt;= 8'd120;&#xa;                            left_motor_action  &lt;= MOTOR_BACK;&#xa;                            right_motor_action &lt;= MOTOR_BACK;&#xa;                            if (lost_timer >= BACKWARD_TIME) begin&#xa;                                lost_timer &lt;= 0;&#xa;                                lost_state &lt;= LOST_IDLE;  &#xa;                            end&#xa;                        end&#xa;                    end&#xa;                end&#xa;&#xa;                // 纯循迹模式&#xa;                TOP_MODE_TRACK: begin&#xa;                    if (lost_state == LOST_IDLE) begin&#xa;                        case (sensor_state)&#xa;                            2'b11: begin&#xa;                                pwm_duty_left  &lt;= 8'd110;&#xa;                                pwm_duty_right &lt;= 8'd110;&#xa;                                left_motor_action  &lt;= MOTOR_FWD;&#xa;                                right_motor_action &lt;= MOTOR_FWD;&#xa;                            end&#xa;                            2'b01: begin&#xa;                                pwm_duty_left  &lt;= 8'd150;&#xa;                                pwm_duty_right &lt;= 8'd40;&#xa;                                left_motor_action  &lt;= MOTOR_FWD;&#xa;                                right_motor_action &lt;= MOTOR_FWD;&#xa;                            end&#xa;                            2'b10: begin&#xa;                                pwm_duty_left  &lt;= 8'd40;&#xa;                                pwm_duty_right &lt;= 8'd150;&#xa;                                left_motor_action &lt;= MOTOR_FWD;&#xa;                                right_motor_action &lt;= MOTOR_FWD;&#xa;                            end&#xa;                            2'b00: begin&#xa;                                pwm_duty_left  &lt;= 8'd110;&#xa;                                pwm_duty_right &lt;= 8'd110;&#xa;                                left_motor_action  &lt;= MOTOR_FWD;&#xa;                                right_motor_action &lt;= MOTOR_FWD;&#xa;                            end&#xa;                        endcase&#xa;                    end&#xa;                    else if (lost_state == LOST_PAUSE) begin&#xa;                        lost_timer &lt;= lost_timer + 1;&#xa;                        pwm_duty_left  &lt;= 8'd0;&#xa;                        pwm_duty_right &lt;= 8'd0;&#xa;                        left_motor_action  &lt;= MOTOR_STOP;&#xa;                        right_motor_action &lt;= MOTOR_STOP;&#xa;                        if (lost_timer >= PAUSE_TIME) begin&#xa;                            lost_timer &lt;= 0;&#xa;                            lost_state &lt;= LOST_BACKWARD;&#xa;                        end&#xa;                    end&#xa;                    else if (lost_state == LOST_BACKWARD) begin&#xa;                        lost_timer &lt;= lost_timer + 1;&#xa;                        pwm_duty_left  &lt;= 8'd120;&#xa;                        pwm_duty_right &lt;= 8'd120;&#xa;                        left_motor_action  &lt;= MOTOR_BACK;&#xa;                        right_motor_action &lt;= MOTOR_BACK;&#xa;                        if (lost_timer >= BACKWARD_TIME) begin&#xa;                            lost_timer &lt;= 0;&#xa;                            lost_state &lt;= LOST_IDLE;&#xa;                        end&#xa;                    end&#xa;                    &#xa;                end&#xa;            endcase&#xa;        end&#xa;    end" Color="#d3d3d3" Comment="" Height="1080" Name="motor_control" Parameters="" Parent="0" Type="model" Width="1600" X="0" Y="0">
 <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="motor_control" Side="left" Width="30" X="-0.01875" Y="0.0694444"/>
 <Port Color="#00ffff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="rst_n" Parent="motor_control" Side="left" Width="30" X="-0.01875" Y="0.152778"/>
 <Port Color="#9acd32" Connect="" Datasize="2" Datatype="wire" Description="" Height="30" Inout="input" Name="top_work_mode" Parent="motor_control" Side="left" Width="30" X="-0.01875" Y="0.236111"/>
 <Port Color="#e9967a" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="sensor_left" Parent="motor_control" Side="left" Width="30" X="-0.01875" Y="0.319444"/>
 <Port Color="#cd5c5c" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="sensor_right" Parent="motor_control" Side="left" Width="30" X="-0.01875" Y="0.402778"/>
 <Port Color="#556b2f" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="ir_left" Parent="motor_control" Side="left" Width="30" X="-0.01875" Y="0.486111"/>
 <Port Color="#006400" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="ir_right" Parent="motor_control" Side="left" Width="30" X="-0.01875" Y="0.569444"/>
 <Port Color="#6495ed" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="left_speed_reg" Parent="motor_control" Side="left" Width="30" X="-0.01875" Y="0.652778"/>
 <Port Color="#0000ff" Connect="" Datasize="8" Datatype="wire" Description="" Height="30" Inout="input" Name="right_speed_reg" Parent="motor_control" Side="left" Width="30" X="-0.01875" Y="0.736111"/>
 <Port Color="#b22222" Connect="" Datasize="2" Datatype="wire" Description="" Height="30" Inout="input" Name="left_dir_reg" Parent="motor_control" Side="left" Width="30" X="-0.01875" Y="0.819444"/>
 <Port Color="#a52a2a" Connect="" Datasize="2" Datatype="wire" Description="" Height="30" Inout="input" Name="right_dir_reg" Parent="motor_control" Side="left" Width="30" X="-0.01875" Y="0.902778"/>
 <Port Color="#7fffd4" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="pwm_duty_left" Parent="motor_control" Side="right" Width="30" X="0.98125" Y="0.186111"/>
 <Port Color="#7fffd4" Connect="" Datasize="8" Datatype="reg" Description="" Height="30" Inout="output" Name="pwm_duty_right" Parent="motor_control" Side="right" Width="30" X="0.98125" Y="0.386111"/>
 <Port Color="#a52a2a" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="left_motor_action" Parent="motor_control" Side="right" Width="30" X="0.98125" Y="0.586111"/>
 <Port Color="#d2691e" Connect="" Datasize="2" Datatype="reg" Description="" Height="30" Inout="output" Name="right_motor_action" Parent="motor_control" Side="right" Width="30" X="0.98125" Y="0.786111"/>
</Module>
