<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="// ==================== 内部关键信号（层次化观察） ====================&#xa;    wire        rx_done;&#xa;    wire [7:0]  rx_data;&#xa;    wire        frame_ready;&#xa;    wire [7:0]  cmd;&#xa;    wire [7:0]  left_speed_reg;&#xa;    wire [7:0]  right_speed_reg;&#xa;    wire [1:0]  left_dir_reg;&#xa;    wire [1:0]  right_dir_reg;&#xa;    wire [1:0]  top_work_mode;&#xa;    wire [1:0]  left_motor_action;&#xa;    wire [1:0]  right_motor_action;&#xa;    wire [7:0]  pwm_duty_left;&#xa;    wire [7:0]  pwm_duty_right;&#xa; // ==================== 内部信号绑定（实例名是 TOP0）====================&#xa;    assign rx_done          = TOP0.blue_tooth4.Rx_Done;&#xa;    assign rx_data          = TOP0.blue_tooth4.Rx_Data;&#xa;    assign frame_ready      = TOP0.packet_parser4.frame_ready;&#xa;    assign cmd              = TOP0.packet_parser4.cmd;&#xa;    assign left_speed_reg   = TOP0.packet_parser4.left_speed_reg;&#xa;    assign right_speed_reg  = TOP0.packet_parser4.right_speed_reg;&#xa;    assign left_dir_reg     = TOP0.packet_parser4.left_dir_reg;&#xa;    assign right_dir_reg    = TOP0.packet_parser4.right_dir_reg;&#xa;    assign top_work_mode    = TOP0.high_level_control5.top_work_mode;&#xa;    assign left_motor_action  = TOP0.motor_control6.left_motor_action;&#xa;    assign right_motor_action = TOP0.motor_control6.right_motor_action;&#xa;    assign pwm_duty_left    = TOP0.motor_control6.pwm_duty_left;&#xa;    assign pwm_duty_right   = TOP0.motor_control6.pwm_duty_right;&#xa;&#xa;    // ==================== 时钟：50MHz，周期 20ns ====================&#xa;    initial clk = 1'b0;&#xa;    always #10 clk = ~clk;&#xa;&#xa;    // ==================== UART 参数（115200 bps） ====================&#xa;    parameter BAUD       = 115200;&#xa;    parameter BIT_PERIOD = 1_000_000_000 / BAUD;  // ≈8680 ns&#xa;&#xa;    // ==================== UART 发送任务（标准 8N1）====================&#xa;    task uart_send_byte;&#xa;        input [7:0] data;&#xa;        integer j;&#xa;        begin&#xa;            uart_rx = 1'b0;          // 起始位&#xa;            #BIT_PERIOD;&#xa;            for (j = 0; j &lt; 8; j = j + 1) begin&#xa;                uart_rx = data[j];&#xa;                #BIT_PERIOD;&#xa;            end&#xa;            uart_rx = 1'b1;          // 停止位&#xa;            #BIT_PERIOD;&#xa;            #(BIT_PERIOD/2);         // 帧间间隔&#xa;        end&#xa;    endtask&#xa;&#xa;    // ==================== 发送完整帧 ====================&#xa;    task send_frame;&#xa;        input [7:0] cmd_byte;&#xa;        input [7:0] lspd;&#xa;        input [7:0] rspd;&#xa;        input [7:0] ldir;&#xa;        input [7:0] rdir;&#xa;        begin&#xa;            $display(&quot;[%0t] >>> 发送帧: AA %02X %02X %02X %02X %02X 55&quot;,&#xa;                     $time, cmd_byte, lspd, rspd, ldir, rdir);&#xa;            uart_send_byte(8'hAA);&#xa;            uart_send_byte(cmd_byte);&#xa;            uart_send_byte(lspd);&#xa;            uart_send_byte(rspd);&#xa;            uart_send_byte(ldir);&#xa;            uart_send_byte(rdir);&#xa;            uart_send_byte(8'h55);&#xa;            // 等待帧解析完成&#xa;            #(BIT_PERIOD * 3);&#xa;        end&#xa;    endtask&#xa;&#xa;    // ==================== 监控关键事件 ====================&#xa;    always @(posedge rx_done) begin&#xa;        $display(&quot;[%0t] rx_done -> data=0x%02X (%0d)&quot;, $time, rx_data, rx_data);&#xa;    end&#xa;&#xa;    always @(posedge frame_ready) begin&#xa;        $display(&quot;[%0t] *** frame_ready = 1, cmd=0x%02X ***&quot;, $time, cmd);&#xa;    end&#xa;&#xa;    always @(top_work_mode) begin&#xa;        $display(&quot;[%0t] ### top_work_mode changed to %b ###&quot;, $time, top_work_mode);&#xa;    end&#xa;&#xa;    // ==================== 主测试 ====================&#xa;    initial begin&#xa;        // 初始化&#xa;        uart_rx      = 1'b1;   // 空闲&#xa;        sensor_left  = 1'b1;   // 都在黑线上&#xa;        sensor_right = 1'b1;&#xa;        ir_left      = 1'b1;   // 无障碍&#xa;        ir_right     = 1'b1;&#xa;        rst_n        = 1'b0;&#xa;        #200;&#xa;        rst_n = 1'b1;&#xa;        #1000;&#xa;&#xa;        // ===== 测试1：验证复位后默认模式为 STOP =====&#xa;        if (top_work_mode === 2'b00)&#xa;            $display(&quot;[TEST 1 PASS] Default mode = STOP&quot;);&#xa;        else&#xa;            $display(&quot;[TEST 1 FAIL] Default mode = %b&quot;, top_work_mode);&#xa;&#xa;        // ===== 测试2：发送遥控命令 (01)，检查一次响应 =====&#xa;        send_frame(8'h01, 8'd100, 8'd150, 8'h01, 8'h02); // 左前进100，右后退150&#xa;        #2000;&#xa;        if (top_work_mode === 2'b01)&#xa;            $display(&quot;[TEST 2 PASS] Mode switched to REMOTE&quot;);&#xa;        else&#xa;            $display(&quot;[TEST 2 FAIL] Mode = %b&quot;, top_work_mode);&#xa;        // 检查电机动作&#xa;        if (left_motor_action === 2'b01 &amp;&amp; right_motor_action === 2'b10)&#xa;            $display(&quot;[TEST 2 MOTOR PASS] Left=FWD, Right=BACK&quot;);&#xa;        else&#xa;            $display(&quot;[TEST 2 MOTOR FAIL] Left=%b, Right=%b&quot;, left_motor_action, right_motor_action);&#xa;        // 检查速度寄存器&#xa;        if (left_speed_reg === 8'd100 &amp;&amp; right_speed_reg === 8'd150)&#xa;            $display(&quot;[TEST 2 SPEED PASS] L=%d, R=%d&quot;, left_speed_reg, right_speed_reg);&#xa;        else&#xa;            $display(&quot;[TEST 2 SPEED FAIL] L=%d, R=%d&quot;, left_speed_reg, right_speed_reg);&#xa;        #(BIT_PERIOD * 5);&#xa;&#xa;        // ===== 测试3：发送循迹+避障命令 (02) =====&#xa;        send_frame(8'h02, 8'd0, 8'd0, 8'd0, 8'd0);&#xa;        #2000;&#xa;        if (top_work_mode === 2'b10)&#xa;            $display(&quot;[TEST 3 PASS] Mode = TRACK_AVOID&quot;);&#xa;        else&#xa;            $display(&quot;[TEST 3 FAIL] Mode = %b&quot;, top_work_mode);&#xa;        // 此时红外无障碍，应处于循迹子模式，电机前进&#xa;        #5000;&#xa;        if (left_motor_action === 2'b01 &amp;&amp; right_motor_action === 2'b01)&#xa;            $display(&quot;[TEST 3 MOTOR PASS] Both FWD&quot;);&#xa;        else&#xa;            $display(&quot;[TEST 3 MOTOR FAIL] L=%b, R=%b&quot;, left_motor_action, right_motor_action);&#xa;&#xa;        // 触发避障：左红外被挡住&#xa;        ir_left = 1'b0;&#xa;        #20000;  // 等待 mode 切换 + 动作稳定&#xa;        // 根据原代码，ir=01时：左轮前进、右轮停止&#xa;        if (left_motor_action === 2'b01 &amp;&amp; right_motor_action === 2'b00)&#xa;            $display(&quot;[TEST 3 AVOID PASS] Left FWD, Right STOP&quot;);&#xa;        else&#xa;            $display(&quot;[TEST 3 AVOID FAIL] L=%b, R=%b&quot;, left_motor_action, right_motor_action);&#xa;        ir_left = 1'b1; // 恢复&#xa;        #10000;&#xa;&#xa;        // ===== 测试4：发送纯循迹命令 (03) =====&#xa;        send_frame(8'h03, 8'd0, 8'd0, 8'd0, 8'd0);&#xa;        #2000;&#xa;        if (top_work_mode === 2'b11)&#xa;            $display(&quot;[TEST 4 PASS] Mode = TRACK&quot;);&#xa;        else&#xa;            $display(&quot;[TEST 4 FAIL] Mode = %b&quot;, top_work_mode);&#xa;        // 循迹：sensor_left脱线，应出现差速转弯&#xa;        sensor_left = 1'b0;&#xa;        #50000;&#xa;        if (pwm_duty_left > pwm_duty_right)&#xa;            $display(&quot;[TEST 4 TURN PASS] Left duty=%d, Right duty=%d&quot;, pwm_duty_left, pwm_duty_right);&#xa;        else&#xa;            $display(&quot;[TEST 4 TURN FAIL] L=%d, R=%d&quot;, pwm_duty_left, pwm_duty_right);&#xa;        sensor_left = 1'b1;&#xa;        #10000;&#xa;&#xa;        // ===== 测试5：错误帧尾恢复 =====&#xa;        // 手动发送一个错误的帧尾&#xa;        uart_send_byte(8'hAA);&#xa;        uart_send_byte(8'h01);&#xa;        uart_send_byte(8'd60);&#xa;        uart_send_byte(8'd60);&#xa;        uart_send_byte(8'h01);&#xa;        uart_send_byte(8'h01);&#xa;        uart_send_byte(8'hFF);   // 错误帧尾&#xa;        #(BIT_PERIOD * 5);&#xa;        // 模式应保持不变（之前是 TRACK 11）&#xa;        if (top_work_mode === 2'b11)&#xa;            $display(&quot;[TEST 5 PASS] Mode unchanged after bad frame&quot;);&#xa;        else&#xa;            $display(&quot;[TEST 5 FAIL] Mode changed to %b&quot;, top_work_mode);&#xa;&#xa;        // 再发一个正确帧，验证恢复正常&#xa;        send_frame(8'h02, 8'd120, 8'd120, 8'h01, 8'h01);&#xa;        #2000;&#xa;        if (top_work_mode === 2'b10)&#xa;            $display(&quot;[TEST 6 PASS] Recovered to TRACK_AVOID&quot;);&#xa;        else&#xa;            $display(&quot;[TEST 6 FAIL] Mode = %b&quot;, top_work_mode);&#xa;&#xa;        // ===== 测试7：PWM 输出是否一直有波形 =====&#xa;        #200000;&#xa;        $display(&quot;[TEST 7] PWM left_en=%b, right_en=%b&quot;, left_motor_en, right_motor_en);&#xa;&#xa;        $display(&quot;\n========== 全部测试完成 ==========\n&quot;);&#xa;        $finish;&#xa;    end" Color="#d3d3d3" Comment="" Height="1285" Name="TOP_test" Parent="0" Timescale="1ns/1ps" Type="test" Width="1892" X="0" Y="0">
 <Module Category="Current" Class="TOP" Code="" Color="#d3d3d3" Comment="" Height="549" Name="TOP0" Parameters="" Parent="TOP_test" Type="model" Width="504" X="643.487" Y="394.971">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="TOP0" Side="left" Width="30" X="-0.0595238" Y="0.0965392"/>
