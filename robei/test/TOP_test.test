  <Port Color="#e9967a" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="sensor_left" Parent="TOP0" Side="left" Width="30" X="-0.0595238" Y="0.344262"/>
  <Port Color="#cd5c5c" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="sensor_right" Parent="TOP0" Side="left" Width="30" X="-0.0595238" Y="0.468124"/>
  <Port Color="#bdb76b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="left_motor_en" Parent="TOP0" Side="right" Width="30" X="0.940476" Y="0.0965392"/>
