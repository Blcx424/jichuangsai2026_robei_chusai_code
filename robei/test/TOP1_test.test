<!DOCTYPE Robei>
<Module Category="Current" Class="module" Code="    // 观察电机内部信号&#xa;    wire [1:0] left_action, right_action;&#xa;    wire [7:0] pwm_l, pwm_r;&#xa;&#xa;    assign left_action  = TOP0.motor_control6.left_motor_action;&#xa;    assign right_action = TOP0.motor_control6.right_motor_action;&#xa;    assign pwm_l        = TOP0.motor_control6.pwm_duty_left;&#xa;    assign pwm_r        = TOP0.motor_control6.pwm_duty_right;&#xa;&#xa;    // 加速PWM&#xa;    defparam TOP0.pwm_generatorL.CLK_DIV = 1;&#xa;    defparam TOP0.pwm_generatorR.CLK_DIV = 1;&#xa;&#xa;    // 时钟&#xa;    initial clk = 0;&#xa;    always #10 clk = ~clk;&#xa;&#xa;    &#xa;    initial begin&#xa;        // 初始化&#xa;        sensor_left  = 1; sensor_right = 1;&#xa;        ir_left      = 1; ir_right     = 1;&#xa;        rst_n = 0; #100; rst_n = 1; #100;&#xa;&#xa;        // ----- 强制进入循迹+避障模式 -----&#xa;        force TOP0.high_level_control5.top_work_mode = 2'b10; // TRACK_AVOID&#xa;        #100;&#xa;&#xa;        // ========== 测试1：巡线状态（红外无障碍）==========&#xa;        $display(&quot;--- 巡线（无障碍）---&quot;);&#xa;        sensor_left = 1; sensor_right = 1;&#xa;        ir_left = 1; ir_right = 1;&#xa;        #2000;&#xa;        $display(&quot;L_action=%b R_action=%b (两者应前进)&quot;, left_action, right_action);&#xa;&#xa;        // ========== 测试2：避障 - 左障碍 ==========&#xa;        $display(&quot;--- 左障碍 (IR=01) ---&quot;);&#xa;        ir_left = 0; ir_right = 1;&#xa;        // 避障模式下传感器状态不重要，但这里仍给巡线状态&#xa;        #2000;&#xa;        $display(&quot;L_action=%b R_action=%b (期望:左前进,右停止)&quot;, left_action, right_action);&#xa;&#xa;        // ========== 测试3：避障 - 右障碍 ==========&#xa;        $display(&quot;--- 右障碍 (IR=10) ---&quot;);&#xa;        ir_left = 1; ir_right = 0;&#xa;        #2000;&#xa;        $display(&quot;L_action=%b R_action=%b (期望:左停止,右前进)&quot;, left_action, right_action);&#xa;&#xa;        // ========== 测试4：避障 - 双障碍 ==========&#xa;        $display(&quot;--- 双障碍 (IR=00) ---&quot;);&#xa;        ir_left = 0; ir_right = 0;&#xa;        #2000;&#xa;        $display(&quot;L_action=%b R_action=%b (期望:双后退)&quot;, left_action, right_action);&#xa;&#xa;        // ========== 测试5：巡线时左传感器脱线 ==========&#xa;        $display(&quot;--- 巡线左脱线 (sensor=01) ---&quot;);&#xa;        ir_left = 1; ir_right = 1;   // 清除障碍&#xa;        sensor_left = 0; sensor_right = 1;&#xa;        #2000;&#xa;        $display(&quot;PWM L=%d R=%d (期望左快右慢)&quot;, pwm_l, pwm_r);&#xa;&#xa;        // ========== 测试6：巡线右脱线 ==========&#xa;        $display(&quot;--- 巡线右脱线 (sensor=10) ---&quot;);&#xa;        sensor_left = 1; sensor_right = 0;&#xa;        #2000;&#xa;        $display(&quot;PWM L=%d R=%d (期望左慢右快)&quot;, pwm_l, pwm_r);&#xa;&#xa;        // ========== 测试7：全脱线 ==========&#xa;        $display(&quot;--- 全脱线 (sensor=00) ---&quot;);&#xa;        sensor_left = 0; sensor_right = 0;&#xa;        #2000;&#xa;        $display(&quot;L_action=%b R_action=%b (期望保持前进)&quot;, left_action, right_action);&#xa;&#xa;        release TOP0.high_level_control5.top_work_mode;&#xa;        $display(&quot;=== 电机测试完成 ===&quot;);&#xa;        $finish;&#xa;    end&#xa;&#xa;" Color="#d3d3d3" Comment="" Height="1080" Name="TOP1_test" Parent="0" Timescale="1ns/1ps" Type="test" Width="1600" X="0" Y="0">
 <Module Category="Current" Class="TOP" Code="/*&#xa;    wire [1:0] work_mode;                     // 当前工作模式&#xa;&#xa;    // 巡线/避障模块输出&#xa;    wire [1:0] line_left_action, line_right_action;&#xa;    wire [7:0] line_pwm_left, line_pwm_right;&#xa;&#xa;    // 蓝牙模块输出&#xa;    wire [1:0] bt_left_action, bt_right_action;&#xa;    wire [7:0] bt_pwm_left, bt_pwm_right;&#xa;    wire bt_control_active;                   // 蓝牙是否正在发送有效指令&#xa;&#xa;    // 电机输出控制模块的最终信号&#xa;    wire [7:0] final_pwm_left, final_pwm_right;&#xa;&#xa;    &#xa;*/" Color="#d3d3d3" Comment="" Height="567" Name="TOP0" Parameters="" Parent="TOP1_test" Type="model" Width="505" X="560" Y="247.5">
  <Port Color="#faebd7" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="clk" Parent="TOP0" Side="left" Width="30" X="-0.0594059" Y="0.220459"/>
