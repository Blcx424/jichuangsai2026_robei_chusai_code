  <Port Color="#bdb76b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="left_motor_en" Parent="TOP0" Side="right" Width="30" X="0.940594" Y="0.220459"/>
  <Port Color="#dc143c" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="left_motor_go" Parent="TOP0" Side="right" Width="30" X="0.940594" Y="0.343915"/>
