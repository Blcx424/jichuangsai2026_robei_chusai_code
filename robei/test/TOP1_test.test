  <Port Color="#bdb76b" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="right_motor_en" Parent="TOP0" Side="right" Width="30" X="0.940594" Y="0.590829"/>
  <Port Color="#0000ff" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="right_motor_go" Parent="TOP0" Side="right" Width="30" X="0.940594" Y="0.714286"/>
  <Port Color="#8a2be2" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="right_motor_back" Parent="TOP0" Side="right" Width="30" X="0.940594" Y="0.837743"/>
  <Port Color="#556b2f" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="ir_left" Parent="TOP0" Side="left" Width="30" X="-0.0594059" Y="0.714286"/>
  <Port Color="#006400" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="ir_right" Parent="TOP0" Side="left" Width="30" X="-0.0594059" Y="0.837743"/>
  <Port Color="#5f9ea0" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="input" Name="uart_rx" Parent="TOP0" Side="left" Width="30" X="-0.0594059" Y="0.0970018"/>
  <Port Color="#7fff00" Connect="" Datasize="1" Datatype="wire" Description="" Height="30" Inout="output" Name="at_pin" Parent="TOP0" Side="right" Width="30" X="0.940594" Y="0.0970018"/>
 </Module>
